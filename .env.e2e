# Environment for browser tests. Deliberately has no provider credentials: a
# browser run must never be able to reach a real payment, email or Meta API.
APP_NAME=Vidlix
APP_ENV=e2e
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8123

DB_CONNECTION=sqlite
DB_DATABASE=database/e2e.sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
EMAIL_PROVIDER=unconfigured
PAYMENT_PROVIDER=unconfigured
PAYOUT_PROVIDER=unconfigured
INSTAGRAM_PROVIDER=unconfigured
PUSH_PROVIDER=unconfigured
FILESYSTEM_DISK=local
