APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ADMIN_EMAIL=admin@vidlix.test
ADMIN_PASSWORD=ChangeMe_Admin1
ADMIN_MOBILE=9999999999

# ---------------------------------------------------------------------------
# Vidlix providers
# Every provider is off until its credentials are present. A missing credential
# is reported as PROVIDER_NOT_CONFIGURED; it never degrades into a fake success.
# Do not commit real values.
# ---------------------------------------------------------------------------

VIDLIX_CURRENCY=INR

# --- Payments (Razorpay, INR) --------------------------------------------
# PAYMENT_PROVIDER=razorpay
PAYMENT_PROVIDER=unconfigured
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_API_BASE=https://api.razorpay.com/v1
# Where the payer's browser lands after checkout. Informational only - the
# return is not a settlement; POST /webhooks/payment is.
PAYMENT_CALLBACK_URL=
PAYMENT_WEBHOOK_SECRET=

# --- Payouts (RazorpayX) -------------------------------------------------
# Defaults to the payment credentials when unset.
PAYOUT_PROVIDER=unconfigured
PAYOUT_KEY_ID=
PAYOUT_KEY_SECRET=
PAYOUT_ACCOUNT_NUMBER=
PAYOUT_MODE=IMPS
PAYOUT_PURPOSE=payout
PAYOUT_WEBHOOK_SECRET=

# --- Email (sendgrid | smtp | ses | postmark) ----------------------------
EMAIL_PROVIDER=unconfigured
EMAIL_API_KEY=
# EMAIL_API_BASE=
EMAIL_WEBHOOK_SECRET=
# hmac_hex (default) | sendgrid_ecdsa | basic
EMAIL_WEBHOOK_SCHEME=hmac_hex
EMAIL_WEBHOOK_PUBLIC_KEY=
EMAIL_WEBHOOK_USERNAME=
EMAIL_WEBHOOK_PASSWORD=
# Domain that receives replies as reply+<routing_token>@<domain>.
# Set SPF, DKIM and DMARC on it before sending anything real.
EMAIL_INBOUND_DOMAIN=
EMAIL_REPLY_PREFIX=reply
# Transactional sender (OTP, confirmations). Threads never use this.
EMAIL_SYSTEM_PREFIX=noreply
# Help desk. Unlike noreply, replies here are read and routed back.
EMAIL_SUPPORT_PREFIX=help

# --- Instagram (official Meta Graph only, no scraping) -------------------
INSTAGRAM_PROVIDER=unconfigured
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://your-domain.test/integrations/instagram/callback
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# --- Object storage (S3 / R2 / Spaces). Videos never live in MySQL. ------
# Cloudflare R2 example:
#   FILESYSTEM_DISK=s3
#   AWS_ACCESS_KEY_ID=<R2 access key id>
#   AWS_SECRET_ACCESS_KEY=<R2 secret access key>
#   AWS_DEFAULT_REGION=auto
#   AWS_BUCKET=vidlix-media
#   AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   AWS_USE_PATH_STYLE_ENDPOINT=true
# FILESYSTEM_DISK=s3
# MEDIA_DISK=
MEDIA_MAX_BYTES=536870912
MEDIA_SIGNED_URL_MINUTES=15

# --- Push (optional, FCM HTTP v1) ----------------------------------------
PUSH_PROVIDER=unconfigured
FCM_CREDENTIALS_PATH=
FCM_PROJECT_ID=

# VIDLIX_SOCIAL_INSTAGRAM=
# VIDLIX_SOCIAL_YOUTUBE=
# VIDLIX_SOCIAL_X=
# VIDLIX_SOCIAL_LINKEDIN=

# --- Scheduler trigger (only for hosts with no cron) ----------------------
# When set, POST /api/internal/scheduler/run with header X-Cron-Token runs the
# scheduler. Leave empty on any host that has real cron.
CRON_TOKEN=
