# Vidlix — production environment
#
# Copy to .env on the server and fill in. Never commit the filled version.
#
# Every provider stays off until its keys are present. The site is safe to
# launch with some of these blank: the interface says what is unavailable
# rather than pretending, so you can go live in stages.
#
# Ordered by what blocks a launch, most blocking first.

# ─────────────────────────────────────────────────────────────────────────────
# Application — required
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME=Vidlix
APP_ENV=production
APP_DEBUG=false
APP_KEY=                              # php artisan key:generate

# The four faces. All four hosts serve the SAME document root — see
# docs/DEPLOYMENT_HOSTINGER.md section 1b.
APP_URL=https://vidlix.in
APP_APP_URL=https://app.vidlix.in
AUTODM_APP_URL=https://autodm.vidlix.in
ADMIN_APP_URL=https://admin.vidlix.in

APP_TIMEZONE=UTC
VIDLIX_CURRENCY=INR

# ─────────────────────────────────────────────────────────────────────────────
# Database — required
# ─────────────────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# ─────────────────────────────────────────────────────────────────────────────
# Session security — required
#
# Without the secure flag the session cookie travels over plain HTTP the first
# time somebody types the address without https.
# ─────────────────────────────────────────────────────────────────────────────
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120

# ─────────────────────────────────────────────────────────────────────────────
# Object storage — required
#
# The default is `local`, which puts uploaded video on the web server's own
# disk. Set this to s3 before launch.
#
# Cloudflare R2: region is "auto", endpoint is the R2 URL, path style on.
# The bucket must be PRIVATE — files are served through signed URLs.
# ─────────────────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=s3
MEDIA_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=vidlix-media
AWS_DEFAULT_REGION=auto
AWS_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true

MEDIA_MAX_BYTES=536870912             # 512 MB
MEDIA_SIGNED_URL_MINUTES=15

# ─────────────────────────────────────────────────────────────────────────────
# Email — required
#
# Without this: no sign-in codes, no inquiry acknowledgements, no replies.
# Nothing is reported as sent; it is stored with provider_not_configured.
#
# Webhooks to register with the provider:
#   https://vidlix.in/webhooks/email/inbound
#   https://vidlix.in/webhooks/email/events
#
# DNS on the sending domain: SPF, DKIM, DMARC, and MX for inbound.
# ─────────────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend                 # resend | sendgrid | postmark | smtp
EMAIL_API_KEY=
EMAIL_INBOUND_DOMAIN=vidlix.in
EMAIL_REPLY_PREFIX=reply

EMAIL_WEBHOOK_SCHEME=svix             # svix (Resend) | sendgrid_ecdsa | basic | hmac_hex
EMAIL_WEBHOOK_SECRET=
# EMAIL_WEBHOOK_PUBLIC_KEY=           # SendGrid only
# EMAIL_WEBHOOK_USERNAME=             # Postmark inbound only
# EMAIL_WEBHOOK_PASSWORD=

# Who each kind of mail comes from. Resolved server-side from the thread's own
# scope, so a sender address can never be spoofed by a client.
MAIL_FROM_ADDRESS=no-reply@vidlix.in
MAIL_FROM_NAME=Vidlix
MAIL_FROM_CREATOR=creator@vidlix.in
MAIL_FROM_EDITOR=editor@vidlix.in
MAIL_FROM_BRAND=brand@vidlix.in
MAIL_FROM_NOTIFICATIONS=notifications@vidlix.in
MAIL_FROM_NOREPLY=no-reply@vidlix.in
MAIL_FROM_HELP=help@vidlix.in
MAIL_FROM_BILLING=billing@vidlix.in

# ─────────────────────────────────────────────────────────────────────────────
# Turnstile — required before public forms are live
#
# Free from Cloudflare. Without it the public contact form has only the
# honeypot and the rate limit standing between it and a bot.
# ─────────────────────────────────────────────────────────────────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Payments — needed only when money starts moving
#
# Razorpay KYC takes weeks. Start it early even if launch does not need it.
#
# Webhook: https://vidlix.in/webhooks/payment
#   events: payment.captured, payment.failed
# ─────────────────────────────────────────────────────────────────────────────
PAYMENT_PROVIDER=                     # razorpay
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SCHEME=hmac_hex
PAYMENT_CALLBACK_URL=https://app.vidlix.in/projects

# Payouts are a separate RazorpayX activation.
# Webhook: https://vidlix.in/webhooks/payout
#   events: payout.processed, payout.failed, payout.reversed
PAYOUT_PROVIDER=
PAYOUT_KEY_ID=
PAYOUT_KEY_SECRET=
PAYOUT_ACCOUNT_NUMBER=                # RazorpayX source account
PAYOUT_MODE=IMPS
PAYOUT_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Instagram and AutoDM — needed only for those features
#
# Webhook: https://vidlix.in/webhooks/meta
#   GET is the verify handshake, POST carries events.
#   Subscribe to the `comments` field for AutoDM.
#
# instagram_manage_messages requires Meta app review. Without it, public
# comment replies work and private replies are shown as unavailable with the
# reason — they are not offered and then quietly failed.
# ─────────────────────────────────────────────────────────────────────────────
INSTAGRAM_PROVIDER=                   # meta
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://app.vidlix.in/integrations/instagram/callback
META_WEBHOOK_VERIFY_TOKEN=            # any long random string; must match the Meta app
META_WEBHOOK_SCHEME=hub_signature
META_GRAPH_VERSION=v21.0
META_SCOPES=instagram_basic,instagram_manage_insights,pages_show_list,pages_read_engagement,business_management

# ─────────────────────────────────────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────────────────────────────────────

# Push notifications. The credentials file must live outside the web root.
PUSH_PROVIDER=                        # fcm
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

# Custom domains. No driver is implemented yet — leaving this unset makes the
# settings page say so rather than accepting a domain that would never be
# served.
CUSTOM_DOMAIN_PROVIDER=unconfigured

# Scheduler trigger, for hosts without cron. Empty means the route 404s.
# With it set, hit POST /api/internal/scheduler/run with the X-Cron-Token header.
CRON_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=warning
