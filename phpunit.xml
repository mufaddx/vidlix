<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>

        <!--
            Every provider is forced off for the suite, so a developer with real
            credentials in .env cannot have tests reach a live provider or
            change what a test asserts. Tests that need a configured provider
            opt in explicitly with config() plus Http::fake().
        -->
        <env name="PAYMENT_PROVIDER" value="unconfigured"/>
        <env name="PAYOUT_PROVIDER" value="unconfigured"/>
        <env name="EMAIL_PROVIDER" value="unconfigured"/>
        <env name="INSTAGRAM_PROVIDER" value="unconfigured"/>
        <env name="PUSH_PROVIDER" value="unconfigured"/>
        <env name="PAYMENT_KEY_ID" value=""/>
        <env name="PAYMENT_KEY_SECRET" value=""/>
        <env name="PAYMENT_WEBHOOK_SECRET" value=""/>
        <env name="PAYOUT_WEBHOOK_SECRET" value=""/>
        <env name="EMAIL_API_KEY" value=""/>
        <env name="EMAIL_WEBHOOK_SECRET" value=""/>
        <env name="META_APP_ID" value=""/>
        <env name="META_APP_SECRET" value=""/>
        <env name="META_WEBHOOK_VERIFY_TOKEN" value=""/>
    </php>
</phpunit>
